{
  "name": "wpp-discreto",
  "version": "0.1.7",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "description": "Local group aliases and message blurring for WhatsApp Web",
  "scripts": {
    "icons": "node scripts/generate-icons.ts",
    "store:assets": "pnpm build && node scripts/store-assets.ts",
    "build": "node scripts/build.ts",
    "dev": "node scripts/dev.ts",
    "deploy:local": "node scripts/deploy-local.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck",
    "test": "pnpm build && jest --runInBand",
    "test:watch": "pnpm build && jest --watch",
    "package": "pnpm build && node scripts/package.ts",
    "hooks:install": "lefthook install",
    "prepare": "lefthook install",
    "commitlint": "commitlint",
    "clean": "node scripts/clean.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@jest/globals": "^30.5.2",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/chrome": "^0.3.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "jest": "^30.5.2",
    "lefthook": "^2.2.2",
    "sass": "^1.107.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  }
}
